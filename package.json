{
  "name": "weekend-merge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc --noEmit -p tsconfig.functions.json && vite build && npm run build:server",
    "preview": "vite preview",
    "test": "vitest --passWithNoTests",
    "test:watch": "vitest",
    "build:server": "esbuild scripts/server.ts --bundle --platform=node --format=esm --outfile=dist-server/server.mjs --external:react --external:react-dom --external:lucide-react --external:zustand --log-level=warning",
    "start": "node --experimental-sqlite dist-server/server.mjs",
    "test:node22": "node --experimental-sqlite node_modules/vitest/vitest.mjs run --config vitest.node22.config.ts",
    "backup:groups": "node --experimental-sqlite scripts/backup-groups.mjs",
    "build:web": "tsc -b && vite build",
    "build:server:only": "tsc --noEmit -p tsconfig.functions.json && npm run build:server"
  },
  "dependencies": {
    "esbuild": "0.28.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
