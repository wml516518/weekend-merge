DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Required in production. Use an absolute PRIVATE persistent path outside releases/static.
PUBLIC_ORIGIN=https://weekendmerge.ailoong.net.cn
GROUP_DB_PATH=/home/admin/apps/weekend-merge/data-runtime/groups.sqlite
# Integer 1–4; one queue-owning Node process only.
GROUP_JOB_CONCURRENCY=2
NODE_ENV=production
HOST=127.0.0.1
PORT=8787
TRUSTED_PROXY_DEPTH=1

# Optional weather fallback. Server only; never use a VITE_ prefix.
# Obtain the dedicated host and API Key from the QWeather console.
# Publish QWeather attribution links before enabling these credentials (docs/WEATHER.md).
QWEATHER_API_HOST=
QWEATHER_API_KEY=
