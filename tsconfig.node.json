{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "vite.config.ts",
    "scripts/local-functions.ts",
    "scripts/server.ts",
    "server/**/*.ts",
    "netlify/functions/**/*.ts",
    "src/contracts/**/*.ts",
    "src/demo/demoRun.ts",
    "data/**/*.json"
  ],
  "exclude": ["**/*.test.ts", "**/*.test.tsx"]
}
